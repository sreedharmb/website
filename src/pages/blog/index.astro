---
import Base from '../../layouts/Base.astro';
import PostLink from '../../components/PostLink.astro';
import { getPosts } from '../../data/posts';
import { profile } from '../../data/profile';

const posts = getPosts();
---

<Base title="Writing" description="Notes on engineering leadership, applied AI and building platforms.">
  <p class="eyebrow">Writing</p>
  <h1>Notes and essays</h1>
  <p class="muted">
    On engineering leadership, applied AI and building platforms. Most of my writing is on <a href={profile.links.linkedinArticles} target="_blank" rel="noopener">LinkedIn</a>.
  </p>

  <ul class="posts">
    {
      posts.map((post) => (
        <li>
          <PostLink post={post} />
          {post.description && <p class="muted">{post.description}</p>}
        </li>
      ))
    }
  </ul>

  <p class="more">
    <a href={profile.links.linkedinArticles} target="_blank" rel="noopener">All my articles on LinkedIn ↗</a>
  </p>
</Base>

<style>
  .posts {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
  }
  .posts li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }
  .posts li > :global(a) {
    font-weight: 600;
    font-size: 1.1rem;
  }
  .posts p {
    margin: 0.2rem 0 0;
    font-size: 0.95rem;
  }
  .more {
    margin-top: 1.5rem;
  }
</style>

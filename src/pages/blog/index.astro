---
import Base from '../../layouts/Base.astro';
import PostLink from '../../components/PostLink.astro';
import { getPosts } from '../../data/posts';
import { profile } from '../../data/profile';

const posts = getPosts();
---

<Base title="Writing" description="Notes on engineering leadership, applied AI and building platforms.">
  <section class="banner">
    <div class="container grid">
      <h1>Notes and essays</h1>
      <p class="lead">
        On engineering leadership, applied AI and building platforms. Most of my writing is on <a href={profile.links.linkedinArticles} target="_blank" rel="noopener">LinkedIn</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ul class="rows grid posts">
        {
          posts.map((post) => (
            <li>
              <h2 class="post">
                <PostLink post={post} />
              </h2>
              {post.description && <p class="desc">{post.description}</p>}
            </li>
          ))
        }
      </ul>

      <p class="more">
        <a href={profile.links.linkedinArticles} target="_blank" rel="noopener">All my articles on LinkedIn</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .posts > li {
    padding-block: var(--space-xl);
    row-gap: var(--space-md);
    align-items: baseline;
  }
  .post {
    grid-column: 1 / span 7;
    display: grid;
    gap: var(--space-sm);
    font-size: var(--text-section);
    line-height: 1.05;
  }
  .post :global(a) {
    text-decoration-thickness: 2px;
  }
  .post :global(.meta) {
    letter-spacing: 0;
    color: var(--color-muted);
  }
  .desc {
    grid-column: 8 / -1;
    align-self: end;
    font-size: 1.0625rem;
  }
  .more {
    margin-top: var(--space-2xl);
  }
  @media (max-width: 60rem) {
    .post,
    .desc {
      grid-column: 1 / -1;
    }
  }
</style>

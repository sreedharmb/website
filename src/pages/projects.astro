---
import Base from '../layouts/Base.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import { projects } from '../data/profile';
---

<Base title="Projects" description="Things I have built, from AI agents to data platforms.">
  <section class="banner">
    <div class="container grid">
      <h1>Things I’ve built</h1>
      <p class="lead">Recent hands-on builds, plus a few platforms from earlier in my career.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ProjectIndex projects={projects} level={2} />
    </div>
  </section>
</Base>

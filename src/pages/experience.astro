---
import Base from '../layouts/Base.astro';
import { company, roles, education } from '../data/profile';

const split = (period: string) => period.split(/\s+[–-]\s+/);
---

<Base title="Experience" description="13 years at KNOLSKAPE, from Software Engineer to CTO.">
  <section class="banner">
    <div class="container grid">
      <h1>Software Engineer to CTO</h1>
      <p class="lead">{company.name}: {company.blurb}, {company.location}.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ol class="rows grid timeline">
        {
          roles.map((r, i) => {
            const [from, to] = split(r.period);
            return (
              <li class={i === 0 ? 'is-now' : undefined}>
                <div class="role">
                  <p class="num period">
                    {from}
                    <br />
                    to {to}
                  </p>
                  <h2>{r.title}</h2>
                </div>
                <ul class="prose points">
                  {r.points.map((pt) => (
                    <li>{pt}</li>
                  ))}
                </ul>
              </li>
            );
          })
        }
        <li>
          <div class="role">
            <p class="num period">{education.period.replace(/\s+[–-]\s+/, ' to ')}</p>
            <h2>Education</h2>
          </div>
          <p class="edu"><strong>{education.degree}</strong>, {education.school}</p>
        </li>
      </ol>
    </div>
  </section>
</Base>

<style>
  .timeline > li {
    padding-block: var(--space-xl) var(--space-2xl);
    row-gap: var(--space-lg);
  }
  .role {
    grid-column: 1 / span 4;
    display: grid;
    gap: var(--space-xs);
    align-content: start;
  }
  .period {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .role h2 {
    font-size: var(--text-title);
    line-height: 1.2;
  }
  .is-now .period {
    color: var(--color-accent);
  }
  .is-now h2 {
    font-size: var(--text-2xl);
  }
  .points {
    grid-column: 5 / -1;
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .edu {
    grid-column: 5 / -1;
    font-size: 1.0625rem;
  }
  .edu strong {
    font-weight: 500;
    color: var(--color-ink);
  }
  @media (max-width: 60rem) {
    .role,
    .points,
    .edu {
      grid-column: 1 / -1;
    }
  }
</style>

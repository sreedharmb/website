---
import { profile } from '../data/profile';

interface Props {
  /** Optional id for in-page links, e.g. "contact" on the About page. */
  id?: string;
  title?: string;
}

const { id, title = 'Get in touch' } = Astro.props;
---

<section class="band-ink contact" id={id} aria-labelledby={`${id ?? 'contact-band'}-title`}>
  <div class="container grid">
    <h2 id={`${id ?? 'contact-band'}-title`}>{title}</h2>
    <div class="contact__body">
      <slot>
        <p class="contact__email">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </p>
        <p class="muted">Based in {profile.location} and open to relocation.</p>
      </slot>
      <p class="contact__links">
        <a href={profile.links.linkedin} target="_blank" rel="me noopener">LinkedIn</a>
        <a href={profile.links.github} target="_blank" rel="me noopener">GitHub</a>
      </p>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--section-gap-s);
  }
  .contact .grid {
    row-gap: var(--space-xl);
    align-items: start;
  }
  h2 {
    grid-column: 1 / span 5;
  }
  .contact__body {
    grid-column: 7 / -1;
    display: grid;
    gap: var(--space-md);
    font-size: var(--text-lead);
  }
  h2 {
    text-wrap: balance;
  }
  .contact__email {
    font: 500 clamp(1.125rem, 2vw + 0.6rem, 1.953rem) / 1.15 var(--font-display);
    white-space: nowrap;
    letter-spacing: var(--tracking-display);
    overflow-wrap: break-word;
    min-width: 0;
  }
  .contact__email a {
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }
  .contact__links {
    display: flex;
    gap: var(--space-xl);
    margin-top: var(--space-md);
    font-size: var(--text-md);
  }
  @media (max-width: 60rem) {
    h2,
    .contact__body {
      grid-column: 1 / -1;
    }
  }
</style>

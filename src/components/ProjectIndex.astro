---
import type { Project } from '../data/profile';

interface Props {
  projects: Project[];
  /** Heading level for each project title: h3 under a section head, h2 on the Projects page. */
  level?: 2 | 3;
}

const { projects, level = 3 } = Astro.props;
const Title = level === 2 ? 'h2' : 'h3';
const years = (y: string) => y.replace(/\s+[–-]\s+/, ' to ');
---

<ul class:list={['rows grid index', { 'index--page': level === 2 }]}>
  {
    projects.map((p) => (
      <li>
        <span class="num index__year">{years(p.year)}</span>
        <Title class="index__title">{p.link ? <a href={p.link}>{p.title}</a> : p.title}</Title>
        <p class="index__summary">{p.summary}</p>
        <ul class="index__tags" aria-label="Built with">
          {p.tags.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      </li>
    ))
  }
</ul>

<style>
  .index > li {
    row-gap: var(--space-xs);
    padding-block: var(--space-xl);
    align-items: baseline;
  }
  .index__year {
    grid-column: 1 / span 2;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .index__title {
    grid-column: 3 / span 3;
    font-size: var(--text-title);
    line-height: 1.2;
  }
  .index__summary {
    grid-column: 6 / span 5;
    font-size: 1.0625rem;
  }
  .index__tags {
    grid-column: 11 / -1;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  /* On the Projects page each project is a section of its own: the title at section size on 1 to 6. */
  .index--page > li {
    padding-block: var(--space-2xl);
  }
  .index--page .index__year {
    grid-column: 1 / -1;
  }
  .index--page .index__title {
    grid-column: 1 / span 6;
    grid-row: 2 / span 2;
    font-size: var(--text-section);
    line-height: 1.05;
  }
  .index--page .index__summary {
    grid-column: 7 / -1;
    font-size: var(--text-lead);
  }
  .index--page .index__tags {
    grid-column: 7 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-md);
  }
  @media (max-width: 60rem) {
    .index--page .index__title {
      grid-row: auto;
    }
    .index__year,
    .index__title,
    .index__summary,
    .index__tags {
      grid-column: 1 / -1;
    }
    .index__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0 var(--space-md);
    }
  }
</style>

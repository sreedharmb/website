---
import type { Post } from '../data/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const external = Boolean(post.source);
---

<a
  href={post.url}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
>{post.title}{external && <span class="visually-hidden"> (opens on {post.source})</span>}</a>
<span class="meta muted">
  {post.source && <span class="source">On {post.source}</span>}
  {post.date && <time datetime={post.date.toISOString()}>{post.dateLabel}</time>}
</span>

<style>
  .meta {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
    align-items: baseline;
    font: 500 var(--text-sm) / 1.3 var(--font-body);
  }
  time {
    font-family: var(--font-outlier);
    font-variant-numeric: tabular-nums;
  }
</style>
